CADDY_DOMAIN=routes.example.com
# For production, set this to a tile service you are authorized to use.
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=<a href="https://www.openstreetmap.org/copyright">&copy; OpenStreetMap contributors</a>
MAX_STOPS=24
OSRM_TIMEOUT_SECONDS=10
SOLVER_TIMEOUT_SECONDS=5
GEOCODER_PROVIDER=photon
GEOCODER_BASE_URL=https://photon.komoot.io
GEOCODER_TIMEOUT_SECONDS=8
GEOCODER_ATTRIBUTION=© OpenStreetMap contributors
# Set a unique application identifier/contact for the geocoding service.
GEOCODER_USER_AGENT=RouteOptimizer/1.0 (configure your contact details)
